{
  "schemaVersion": 1,
  "id": "naturescompass",
  "version": "${version}",

  "name": "Nature's Compass",
  "description": "Search for a biome and get information about it.",
  "authors": [
    "lucalabs-de",
    "ChaosTheDude"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/natures-compass-explorers-edition",
    "sources": "https://github.com/lucalabs-de/NaturesCompass"
  },

  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/naturescompass/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lucalabs.naturescompass.NaturesCompass"
    ],
    "client": [
      "com.lucalabs.naturescompass.NaturesCompassClient"
    ],
    "jei_mod_plugin": [
      "com.lucalabs.naturescompass.integrations.jei.JeiIntegration"
    ]
  },
  "mixins": [
    "naturescompass.mixins.json"
  ],
  "accessWidener" : "naturescompass.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric": "*",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "explorerscompass": "*"
  }
}
